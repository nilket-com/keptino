#!/bin/sh
# Check the actual outgoing object, including its already-published ancestors.
status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
	case "$local_sha" in
		*[!0]*) ;;
		*)
			if [ "$remote_ref" = refs/heads/main ]; then
				echo 'pre-push: refusing to delete main' >&2
				status=1
			fi
			continue ;;
	esac
	if ! report=$(python3 -B ci/commit_subjects.py --repo . --commit "$local_sha"); then
		printf 'pre-push: refused %s\n%s\n' "$remote_ref" "$report" >&2
		status=1
	fi
done
exit "$status"
