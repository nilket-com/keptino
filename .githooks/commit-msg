#!/usr/bin/env python3
"""Check the next local decision or implementation before signing."""
import pathlib
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "ci"))
from commit_subjects import HistoryError, expected_subject, resolve, subject_error  # noqa: E402

lines = [line for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
         if not line.startswith("#")]
while lines and not lines[-1].strip():
    lines.pop()
errors = []
if not lines:
    errors.append("empty message")
else:
    error = subject_error(lines[0])
    if error:
        errors.append(error)
    else:
        try:
            kind, number = expected_subject(".", resolve(".", "HEAD"))
            if not lines[0].startswith(f"{kind}: adr {number} "):
                errors.append(f"expected {kind}: adr {number}")
        except HistoryError as problem:
            errors.append(str(problem))
    if len(lines) > 1:
        errors.append("commit messages must have no body (no trailers, no attribution lines): "
                      + repr(lines[-1]))
if errors:
    sys.stderr.write("commit-msg: refused, see ci/commit-subjects.md\n")
    for error in errors:
        sys.stderr.write(f"  {error}\n")
    raise SystemExit(1)
